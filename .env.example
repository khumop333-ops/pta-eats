# Copy this file to .env and fill in your own values.
# These are PUBLIC (anon) keys — they are safe to expose in the browser bundle.
# Never put service_role keys here.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Fresh backend config (NEW) - NOW PRIMARY
# Set to true to use the local Express backend (migrated all pages)
VITE_USE_BACKEND=true
VITE_API_URL=/api

# Backend will run on http://localhost:3001
# Frontend dev server proxies /api -> backend automatically
# Set to false to fallback to Supabase
