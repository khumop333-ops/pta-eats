# Copy this file to .env and fill in your own values.
# These are PUBLIC (anon) keys — they are safe to expose in the browser bundle.
# Never put service_role keys here.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Digits only, E.164 format without plus. Example for +27 83 123 4567: 27831234567
VITE_ROMA_WHATSAPP_NUMBER=
